# Copiar a .env y completar. NUNCA commitear el .env real.

# --- Origen: Tango on-premise (LAN) ---
TANGO_BASE_URL=http://arenales_tango:17000
TANGO_API_TOKEN=pegar-aca-el-token-de-apertura-api
TANGO_COMPANY_ID=2

# Consulta Live de ventas. El custom query selecciona el schema guardado
# en "Mis consultas" (el 9 agrega COD_CLIENTE y DESCRIPCION_ADICIONAL).
TANGO_SALES_PROCESS_ID=17839
TANGO_SALES_CUSTOM_QUERY_ID=9

# Consulta Live de clientes.
TANGO_CUSTOMERS_PROCESS_ID=17851
TANGO_CUSTOMERS_CUSTOM_QUERY_ID=10

# --- Destino: MYLOS (HTTPS saliente) ---
MYLOS_BASE_URL=https://api.mylos.app
MYLOS_INGEST_TOKEN=pegar-aca-el-token-de-ingesta

# Los PROCESS_ID son obligatorios para el comando que los use.
# Los CUSTOM_QUERY_ID pueden quedar vacios: la consulta corre con su schema
# por defecto. El flag --custom-query pisa lo que diga el entorno.
# MYLOS_BASE_URL y MYLOS_INGEST_TOKEN son obligatorias: todos los comandos
# envian a MYLOS.

# Opcionales (valores por defecto entre parentesis)
# TANGO_HTTP_TIMEOUT=60s        (60s)
# TANGO_MAX_RETRIES=3           (3) reintentos ante errores transitorios
# TANGO_RETRY_BASE_DELAY=500ms  (500ms) backoff exponencial con jitter
# MYLOS_HTTP_TIMEOUT=60s        (60s)
# MYLOS_MAX_RETRIES=3           (3)
# MYLOS_RETRY_BASE_DELAY=500ms  (500ms)
# TANGO_DATE_FORMAT=02/01/2006  (02/01/2006) layout Go para fromDate/toDate.
#   ATENCION: el default dd/MM/yyyy es una HIPOTESIS sin verificar end-to-end.
#   No lo cambies "a ver si anda": 0 filas NO demuestra que el formato este mal.
#   Para demostrarlo hace falta un dia con dia > 12 del que sepamos que hubo
#   ventas. Alternativas: 2006-01-02 (ISO), 01/02/2006 (MM/dd/yyyy).
