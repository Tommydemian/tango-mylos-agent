# Copiar a .env y completar. NUNCA commitear el .env real.

# Obligatorias
TANGO_BASE_URL=http://arenales_tango:17000
TANGO_API_TOKEN=pegar-aca-el-token-de-apertura-api
TANGO_COMPANY_ID=2
TANGO_SALES_PROCESS_ID=17839

# Opcionales (valores por defecto entre parentesis)
# TANGO_HTTP_TIMEOUT=60s        (60s)
# TANGO_MAX_RETRIES=3           (3) reintentos ante errores transitorios
# TANGO_RETRY_BASE_DELAY=500ms  (500ms) backoff exponencial con jitter
# TANGO_DATE_FORMAT=02/01/2006  (02/01/2006) layout Go para fromDate/toDate.
#   El default 02/01/2006 (dd/MM/yyyy) es el formato observado en Tango.
#   Si algun server esperara otra cosa, se cambia aca sin recompilar
#   (ej: 2006-01-02 para ISO, 01/02/2006 para MM/dd/yyyy).
